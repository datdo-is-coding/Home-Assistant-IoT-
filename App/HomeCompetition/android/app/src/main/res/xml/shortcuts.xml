<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Google Assistant Capability: Query Power & Status -->
    <capability android:name="actions.intent.GET_THING">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.dtv.homeassistant.dtv_home_assistant"
            android:targetClass="com.homecompetition.app.MainActivity"
            android:data="dtvenergy://status">
            <parameter
                android:name="thing.name"
                android:key="query"/>
        </intent>
    </capability>

    <!-- Google Assistant Capability: Open Settings -->
    <capability android:name="actions.intent.OPEN_APP_FEATURE">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.dtv.homeassistant.dtv_home_assistant"
            android:targetClass="com.homecompetition.app.MainActivity"
            android:data="dtvenergy://settings">
        </intent>
    </capability>
</shortcuts>
