# DTV Smart Home Gateway - Example Environment Configuration
# Copy this file to .env and adjust values as needed.

# MQTT Settings
MQTT_BROKER="127.0.0.1"
MQTT_PORT="8883"
MQTT_USERNAME=""
MQTT_PASSWORD=""
MQTT_CLIENT_ID="smarthome_gateway"

# Security & Web Settings
BOOTSTRAP_PASSWORD=""
WEB_HOST="127.0.0.1"
WEB_PORT="8000"
WEB_PUBLIC_ORIGIN="https://gateway.local"
SESSION_TTL_SECONDS="43200"

# AI Settings
AI_ENABLED="false"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.1-flash-lite"

# Database & Firmware Paths
GATEWAY_DB="/var/lib/smarthome/gateway.db"
AUTH_DB="/home/pi4/smarthome/auth.db"
FIRMWARE_DIR="/home/pi4/Home-Assistant-IoT-/Gateway/firmware"

# Text-to-Speech (TTS) Settings
TTS_PROVIDER="edgetts"
TTS_VOICE="vi-VN-HoaiMyNeural"
TTS_RATE="-4%"
TTS_PITCH="+2Hz"
