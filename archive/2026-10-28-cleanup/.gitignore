# Keep private-key examples and compiled APK copies on disk only.
/files/**/*_key.pem
/files/apk/*.apk

# Old compiled images stay local; they may contain embedded credentials.
/files/**/*.bin
/files/**/*.elf
/files/**/*.so
/files/**/*.a
/files/**/*.o

# Embedded CAD history repositories stay local, not Git submodules.
/files/Hardware/PCB/**/.history/
