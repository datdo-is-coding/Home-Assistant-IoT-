<div class="container">
  <!-- Top Brand Header -->
  <div class="header">
    <text class="brand">DTV WATCH</text>
    <div class="status-dot {{ isConnected ? 'online' : 'offline' }}"></div>
  </div>

  <!-- Central Power Gauge -->
  <div class="gauge-box">
    <text class="power-val">{{ power }}</text>
    <text class="power-unit">WATT</text>
    <text class="load-status {{ loadClass }}">{{ loadText }}</text>
  </div>

  <!-- Bottom Metric Grid -->
  <div class="metrics-grid">
    <div class="metric-item">
      <text class="m-label">ĐIỆN ÁP</text>
      <text class="m-val">{{ voltage }}V</text>
    </div>
    <div class="metric-item">
      <text class="m-label">DÒNG ĐIỆN</text>
      <text class="m-val">{{ current }}A</text>
    </div>
  </div>

  <!-- EVN Cost Bar -->
  <div class="cost-bar">
    <text class="cost-label">TIỀN ĐIỆN EVN</text>
    <text class="cost-val">{{ evnCost }} đ</text>
  </div>

  <!-- High Load Warning Overlay Popup -->
  <div class="warning-overlay" if="{{ isHighLoad }}">
    <text class="warn-title">🚨 CẢNH BÁO TẢI CAO!</text>
    <text class="warn-msg">Công suất {{ power }}W vượt ngưỡng an toàn!</text>
    <input type="button" class="warn-btn" value="ĐÃ HIỂU" onclick="dismissWarning" />
  </div>
</div>
