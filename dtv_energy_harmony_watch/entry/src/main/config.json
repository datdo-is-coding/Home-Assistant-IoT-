{
  "app": {
    "bundleName": "com.dtvteam.energywatch",
    "vendor": "dtvteam",
    "version": {
      "code": 1000000,
      "name": "1.0.0"
    }
  },
  "deviceConfig": {
    "default": {}
  },
  "module": {
    "package": "com.dtvteam.energywatch",
    "name": ".MyApplication",
    "deviceType": [
      "liteWearable",
      "wearable"
    ],
    "distro": {
      "deliveryWithInstall": true,
      "moduleName": "entry",
      "moduleType": "entry"
    },
    "abilities": [
      {
        "name": "default",
        "icon": "$media:icon",
        "label": "DTV Power Watch",
        "type": "page",
        "visible": true,
        "orientation": "unspecified"
      }
    ],
    "js": [
      {
        "name": "default",
        "pages": [
          "pages/index/index"
        ],
        "window": {
          "designWidth": 454,
          "autoDesignWidth": true
        }
      }
    ]
  }
}
