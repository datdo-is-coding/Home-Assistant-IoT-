# Copy to /etc/home-competition/core.env, owned by the service user, mode 600.
# Secrets are unique per installation; never use this example as credentials.
HC_MQTT_HOST=localhost
HC_MQTT_PORT=8883
HC_MQTT_USER=hc-gateway
HC_MQTT_PASSWORD=REPLACE_WITH_UNIQUE_SECRET
HC_MQTT_CA=/etc/home-competition/ca.pem
HC_OTA_PUBLIC_KEY=/etc/home-competition/firmware-signing-public.pem
HC_PUBLIC_ORIGIN=https://homecompetition.local
